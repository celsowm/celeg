build/
build-*/
out/
__pycache__/
*.user
.vs/
.cache/
*.txt
*.log
# Model weights / tokenizer artifacts are fetched at runtime by the C++ HF
# cache downloader (src/download_main.cpp). Do not commit them. This pattern
# also matches directories merely *named* "model" that hold source code, not
# checkpoints (src/model, src/backend/cuda/model, include/celeg/model,
# include/celeg/detail/model) -- each is re-included below.
model/

# These are source code, not checkpoint directories.
!src/backend/cuda/model/
!src/backend/cuda/model/**
!include/celeg/backend/cuda/model/
!include/celeg/backend/cuda/model/**
!src/backend/metal/model/
!src/backend/metal/model/**
!src/model/
!src/model/**
!include/celeg/model/
!include/celeg/model/**
!include/celeg/detail/model/
!include/celeg/detail/model/**

# Third-party sources cloned/built locally for reference benchmarking
# (e.g. llama.cpp). Never committed. Benchmark model weights are not stored
# under benchmarks/ at all -- both engines read from the user's default HF
# hub cache (see benchmarks/run_bench.py).
.externals/
benchmarks/results/*
!benchmarks/results/
!benchmarks/results/metal_lfm25_350m_q4_k_m.json
run_asan_qwen.bat
.hermes/
